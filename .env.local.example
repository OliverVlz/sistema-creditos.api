# Configuración para desarrollo LOCAL
# Copia este archivo y renómbralo a .env para usar en desarrollo local

# Application Configuration
NODE_ENV=development
PORT=3000
WEB_BASE_URL=http://localhost:3000
PASSWORD_RECOVERY_EXPIRATION=15min

# Database Configuration (PostgreSQL) - Para desarrollo local
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sistema_creditos_dev

# JWT Configuration
JWT_SECRET=desarrollo_jwt_secret_local_muy_seguro_2024
JWT_EXPIRES_IN=7d

# Configuración de logs y herramientas de desarrollo
LOKI_ENABLED=false
LOKI_HOST=http://localhost:3100
LOKI_SUFFIX_APP=local

# CORS Configuration (permitir frontend local)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200

# Recaptcha Configuration (deshabilitado en desarrollo)
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET= secret-key-aqui

# Mail Configuration (para desarrollo local con Mailhog o MailDev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=mailhog
MAIL_PASSWORD=mailhog
MAIL_FROM=no-reply@sistema-creditos-local.com

# MinIO Configuration (Storage para documentos)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=loan-documents
MINIO_PUBLIC_ENDPOINT=localhost:9000
