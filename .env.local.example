# Configuración para desarrollo LOCAL
# Copia este archivo y renómbralo a .env para usar en desarrollo local

# Application Configuration
NODE_ENV=development
PORT=3000
WEB_BASE_URL=http://localhost:3000
MAIL_LOGO_OBJECT_KEY=branding/logo-color.png
MASSIVE_IMPORT_TEMPLATE_OBJECT_KEY=branding/Plantilla-subida-masiva.xlsx
PASSWORD_RECOVERY_EXPIRATION=15min

# Database Configuration (PostgreSQL) - Para desarrollo local
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sistema_creditos_dev

# JWT Configuration
JWT_SECRET=desarrollo_jwt_secret_local_muy_seguro_2024
JWT_EXPIRES_IN=7d

# Configuración de logs y herramientas de desarrollo
LOKI_ENABLED=false
LOKI_HOST=http://localhost:3100
LOKI_SUFFIX_APP=local

# CORS Configuration (permitir frontend local)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200

# Recaptcha Configuration (deshabilitado en desarrollo)
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET= secret-key-aqui

# Mail Configuration (para desarrollo local con Mailhog o MailDev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=mailhog
MAIL_PASSWORD=mailhog
MAIL_FROM=notificaciones@inversionesmurillomartinez.com
RESEND_API_KEY=
RESEND_FROM=notificaciones@inversionesmurillomartinez.com
RESEND_REPLY_TO=inversionesmurillomartinez@outlook.es

# Buzón donde recibir los mensajes del formulario "Contáctanos" del sitio web (requerido para ese envío)
CONTACT_NOTIFICATION_EMAIL=inversionesmurillomartinez@outlook.es
LOAN_CONTRACT_TEMPLATE_URL=
LOAN_CONTRACT_TEMPLATE_OBJECT_KEY=branding/Formato-contrato-firma.pdf

# MinIO Configuration (Storage para documentos)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_PUBLIC_READ=false
MINIO_BUCKET=loan-documents
MINIO_PUBLIC_BUCKET=public
MINIO_PUBLIC_BASE_URL=

# Seed (pnpm seed): usuario admin inicial — obligatorio para crear el admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opcional: si no se definen, el seeder usa nombre, documento y teléfono por defecto
# SEED_ADMIN_FIRST_NAME=
# SEED_ADMIN_LAST_NAME=
# SEED_ADMIN_DOCUMENT_NUMBER=
# SEED_ADMIN_PHONE=
